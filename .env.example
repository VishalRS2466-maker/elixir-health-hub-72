# Copy to .env and fill in. Never commit real values.

# --- Backend (Lovable Cloud / Supabase) ---
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id

# Server-side equivalents (used during SSR / server functions)
SUPABASE_URL=your_supabase_url
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_PROJECT_ID=your_supabase_project_id

# --- Google Maps (browser key: referrer-restricted, safe to expose) ---
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=your_google_maps_browser_key
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=optional_usage_channel_id

# --- Google Maps (server key, used by the Places server function) ---
# Provided automatically by the Lovable Google Maps connector.
GOOGLE_MAPS_API_KEY=your_google_maps_server_key
LOVABLE_API_KEY=your_lovable_gateway_key
